<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Tennanova</string>
	<key>CFBundleDisplayName</key>
	<string>Tennanova</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon.icns</string>
	<key>CFBundleIdentifier</key>
	<string>com.tennanova.mac</string>
	<key>CFBundleExecutable</key>
	<string>TennaNova</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>3</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>

	<!-- So a file dropped on the Dock icon, or `open -a Tennanova <file>`, reaches
	     `application(_:open:)` and is sent to the phone. Viewer/None: this app neither
	     edits a document nor claims to own any type, it only forwards one. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Any file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
			</array>
		</dict>
	</array>

	<!-- Deliberately no LSUIElement. The app is a regular Dock application with a main
	     window; the menu bar item stays as a second, always-there entry point. -->

	<!-- macOS 15+ requires both of these to use Bonjour / the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Tennanova connects directly to your Android phone on this network to sync notifications and the clipboard. Nothing is sent to any server.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_tennanova._tcp</string>
	</array>
</dict>
</plist>
