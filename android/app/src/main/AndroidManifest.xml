<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- SMS mirroring. The first runtime permissions in this app: everything before them
         was a deep link to a Settings screen. All three are optional and requested only
         when the user turns SMS on, and the app stays fully useful without any of them.
         READ_CONTACTS is what lets numbers reach the Mac already resolved to names, so
         the Mac needs no contacts protocol of its own.
         Play Store's SMS/Call-Log policy is not a constraint here: this app is sideloaded
         and never published (see build.gradle.kts). -->
    <!-- Received files. Optional: the socket lives in a bound service with no UI, so a
         file pushed from the Mac while the phone is in a pocket would otherwise land in
         Downloads with nothing to show for it. Denied, the dashboard's own transfer list
         is still there, and nothing else changes. Writing into the public Downloads
         collection needs no storage permission at all on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Calls. Both are optional, and neither is needed to *see* a call on the Mac:
         calls are read out of notifications, which the listener already receives, and most
         dialers put answer and decline intents in the notification itself. These two exist
         for the dialer that does not — ANSWER_PHONE_CALLS is what lets TelecomManager
         accept or end the call instead. READ_PHONE_STATE accompanies it because Android
         will not grant call control meaningfully without it.
         There is no CAPTURE_AUDIO_OUTPUT here and there cannot be: it is privileged, so no
         third-party app can carry call audio. The Mac controls the call; the phone carries
         the sound. -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TennaNova">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <!-- Anything else shared into this app is a file for the Mac. Text keeps going
                 to the clipboard, and an image is ambiguous enough to be worth asking
                 about — see MainActivity.consumeSharedContent. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Bound by the system; hosts the WebSocket client for its whole lifetime. -->
        <service
            android:name=".notifications.TennaNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- One-time user-enabled service used to notice copy actions and obtain the brief
             focus Android requires before reading the clipboard. During an active,
             user-approved mirror session it can also dispatch bounded gestures and global
             navigation actions. It never retrieves the Android window-content tree. -->
        <service
            android:name=".clipboard.TennaAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".mirror.MirrorProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <provider
            android:name=".clipboard.ClipboardFileProvider"
            android:authorities="com.tennanova.clipboard"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/clipboard_paths" />
        </provider>

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

    </application>
</manifest>
