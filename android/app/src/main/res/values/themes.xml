<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only the launch window uses this; Compose owns everything after. windowBackground has
      to match TennaTheme's backdrop or the app flashes the framework default before first
      draw. The app is light-only, so there is no values-night twin — one would put a dark
      launch window in front of a light UI.
    -->
    <style name="Theme.TennaNova" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/launch_backdrop</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
